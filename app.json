{
  "expo": {
    "name": "Helix",
    "slug": "Helix",
    "scheme": "helix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#000000"
    },
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.helixfit.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos of your meals for automatic nutrition calculation.",
        "NSPhotoLibraryUsageDescription": "Used to select photos of your meals for automatic nutrition calculation.",
        "NSSpeechRecognitionUsageDescription": "Allow Helix to transcribe your voice into food descriptions.",
        "NSMicrophoneUsageDescription": "Allow Helix to use your microphone to log food by voice."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "splash": {
        "backgroundColor": "#000000"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.helixfit.app",
      "versionCode": 17
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-image",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Helix to use your microphone to log food by voice.",
          "speechRecognitionPermission": "Allow Helix to transcribe your voice into food descriptions."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Helix reads your sleep and heart rate data to assess your recovery and adjust training recommendations.",
          "NSHealthUpdateUsageDescription": "Helix does not write health data."
        }
      ],
      [
        "react-native-health-connect",
        {
          "permissions": [
            "android.permission.health.READ_SLEEP",
            "android.permission.health.READ_HEART_RATE_VARIABILITY",
            "android.permission.health.READ_RESTING_HEART_RATE",
            "android.permission.health.READ_STEPS"
          ]
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableProguardInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "./plugins/withAbiFilters",
      "./plugins/withBlackSplash",
      "./plugins/withHealthConnectDelegate",
      "./plugins/withHealthConnectPermissions",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "b34eb723-b7ca-4176-be39-5ee9f81ac340"
      }
    },
    "owner": "helixfitapp"
  }
}
